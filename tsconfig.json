{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "*.ts"
  ]
}